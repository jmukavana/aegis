# Copy to .env for local runs. Defaults already target the docker-compose services below.
DATABASE_URL=postgresql+asyncpg://aegis:aegis@localhost:15432/aegis
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5318
OTEL_SERVICE_NAME=observability-ai
# Leave empty to keep the Kubernetes event watcher disabled (Phase 0 needs no cluster).
KUBE_CONTEXT=
